# Maintainer: FreedomNAS Team <dev@freedomnas.io>
pkgname=freedomnas-installer
_basever=0.9.20
_ref=${FREEDOMNAS_REF:-dev}
pkgver=0.9.20
pkgrel=1
pkgdesc="Profile-driven FreedomNAS installer (clean install or in-place)"
arch=('any')
url="https://github.com/FreedomNAS/freedomnas-installer"
license=('MPL-2.0')
depends=(
    'freedomnas-core'
    'freedomnas-profiles'
    'python'
    'dialog'
    'gptfdisk'
    'dosfstools'
    'zfs-utils'
    'dracut'
    'efibootmgr'
    'curl'
)
optdepends=('debootstrap: bootstrap a Debian target natively')
makedepends=(git)
case "${_ref}" in
    v[0-9]*) _fragment="tag=${_ref}" ;;
    *) _fragment="branch=${_ref}" ;;
esac
source=("git+https://github.com/FreedomNAS/freedomnas-installer.git#${_fragment}")
sha256sums=('SKIP')

pkgver() {
    cd "${srcdir}/${pkgname}"
    case "${_ref}" in
        main|v[0-9]*) printf '%s' "${_basever}" ;;
        *) printf '%s+%s.%s' "${_basever}" \
               "$(git log -1 --format=%cd --date=format:%Y%m%d%H%M%S)" \
               "$(git log -1 --format=%h)" ;;
    esac
}

package() {
    cd "${srcdir}/${pkgname}"

    # Install the installer to /usr/lib/freedomnas/installer
    install -Dm 755 setup.py "${pkgdir}/usr/lib/freedomnas/installer/setup.py"
    mkdir -p "${pkgdir}/usr/lib/freedomnas/installer/lib"
    install -Dm 644 lib/*.py "${pkgdir}/usr/lib/freedomnas/installer/lib/"

    # Boot-chain assets (Clover, zz-dracut-uki) come from freedomnas-profiles

    # User-facing entry point
    mkdir -p "${pkgdir}/usr/bin"
    ln -sf /usr/lib/freedomnas/installer/setup.py "${pkgdir}/usr/bin/freedomnas-install"

    # Install license if present
    if [ -f LICENSE ]; then install -Dm 644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"; fi
    if [ -f README.md ]; then install -Dm 644 README.md "${pkgdir}/usr/share/doc/${pkgname}/README.md"; fi
}
