# Maintainer: FreedomNAS Team <dev@freedomnas.io>
pkgname=freedomnas-keyring
pkgver=20261118
pkgrel=1
pkgdesc="FreedomNAS pacman repository key and server address"
arch=('any')
url="https://github.com/FreedomNAS/freedomnas-arch"
license=('GPL-3.0-or-later')
depends=('pacman')
install=freedomnas-keyring.install
source=('freedomnas.gpg' 'freedomnas-trusted' 'freedomnas-revoked')
sha256sums=('SKIP' 'SKIP' 'SKIP')

package() {
    for f in freedomnas.gpg freedomnas-trusted freedomnas-revoked; do
        install -Dm644 "$srcdir/$f" "$pkgdir/usr/share/pacman/keyrings/$f"
    done
}
