# Maintainer: FreedomNAS Team <dev@freedomnas.io>
pkgname=freedomnas-profiles
_basever=0.9.20
_ref=${FREEDOMNAS_REF:-dev}
pkgver=0.9.20
pkgrel=1
pkgdesc="FreedomNAS OS Profiles — JSON Translator Layer for universal appliance"
arch=('any')
url="https://codeberg.org/FreedomNAS/freedomnas-profiles"
license=('MPL-2.0')
depends=(binutils diffutils)
makedepends=(git)
case "${_ref}" in
    v[0-9]*) _fragment="tag=${_ref}" ;;
    *) _fragment="branch=${_ref}" ;;
esac
source=("git+https://codeberg.org/FreedomNAS/freedomnas-profiles.git#${_fragment}")
sha256sums=('SKIP')

pkgver() {
    cd "${srcdir}/${pkgname}"
    case "${_ref}" in
        main|v[0-9]*) printf '%s' "${_basever}" ;;
        *) printf '%s+%s.%s' "${_basever}" \
               "$(git log -1 --format=%cd --date=format:%Y%m%d%H%M%S)" \
               "$(git log -1 --format=%h)" ;;
    esac
}

package() {
    cd "${srcdir}/${pkgname}"

    # Install profiles to /usr/lib/freedomnas/profiles
    mkdir -p "${pkgdir}/usr/lib/freedomnas/profiles"
    cp -r os init installer storage network shares users packages assets \
        "${pkgdir}/usr/lib/freedomnas/profiles/"

    # Install license if exists
    if [ -f LICENSE ]; then install -Dm 644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"; fi
    if [ -f README.md ]; then install -Dm 644 README.md "${pkgdir}/usr/share/doc/${pkgname}/README.md"; fi
}
