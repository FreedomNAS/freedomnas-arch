# Maintainer: FreedomNAS Team <dev@freedomnas.io>
pkgname=freedomnas-webui
_basever=0.9.11
_ref=${FREEDOMNAS_REF:-dev}
pkgver=0.9.11
pkgrel=1
pkgdesc="FreedomNAS WebUI — FastAPI appliance interface"
arch=('any')
url="https://codeberg.org/FreedomNAS/freedomnas-webui"
license=('MPL-2.0')
depends=(
    'freedomnas-core'
    'freedomnas-profiles'
    'freedomnas-docs'
    'python'
    'python-fastapi'
    'uvicorn'
    'python-websockets'
    'python-jinja'
    'python-pam'
    'python-yaml'
)
optdepends=('cronie: start the WebUI at boot through the @reboot entry')
makedepends=(git)
case "${_ref}" in
    v[0-9]*) _fragment="tag=${_ref}" ;;
    *) _fragment="branch=${_ref}" ;;
esac
source=("git+https://codeberg.org/FreedomNAS/freedomnas-webui.git#${_fragment}")
sha256sums=('SKIP')

pkgver() {
    cd "${srcdir}/${pkgname}"
    case "${_ref}" in
        main|v[0-9]*) printf '%s' "${_basever}" ;;
        *) printf '%s+%s.%s' "${_basever}" \
               "$(git log -1 --format=%cd --date=format:%Y%m%d%H%M%S)" \
               "$(git log -1 --format=%h)" ;;
    esac
}

package() {
    cd "${srcdir}/${pkgname}"

    install -d "${pkgdir}/usr/lib/freedomnas/webui"
    cp -r api frontend websocket "${pkgdir}/usr/lib/freedomnas/webui/"
    echo "${pkgver}" > "${pkgdir}/usr/lib/freedomnas/webui/VERSION"

    # firstboot.sh and supervisor.sh are shared verbatim with the image
    # builder and live in freedomnas-profiles/assets: symlink rather than
    # vendor a second copy that could drift.
    install -d "${pkgdir}/usr/lib/freedomnas/webui/bin"
    ln -sf ../../profiles/assets/firstboot.sh \
        "${pkgdir}/usr/lib/freedomnas/webui/bin/firstboot.sh"
    ln -sf ../../profiles/assets/supervisor.sh \
        "${pkgdir}/usr/lib/freedomnas/webui/bin/supervisor.sh"

    if [ -f LICENSE ]; then install -Dm 644 LICENSE "${pkgdir}/usr/share/licenses/${pkgname}/LICENSE"; fi
    if [ -f README.md ]; then install -Dm 644 README.md "${pkgdir}/usr/share/doc/${pkgname}/README.md"; fi
}
